{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awec2026",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-31",
  "observability": {
    "enabled": true
  },

  // 静的ページは ./public。Worker は /api/* だけを処理し、それ以外は assets に流す。
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // AGEWEC 本体（agewec-site / agewec_2026）とは別の Worker・別の D1。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "videoeval",
      "database_id": "fb5337cc-a4b3-49e4-a23d-f7d8f3809a36"
    }
  ]

  // シークレットはダッシュボードで設定する:
  //   SESSION_SECRET   Cookie の署名鍵
  //   BOOTSTRAP_TOKEN  /setup/ の合言葉（初期化後は削除してよい）
}
