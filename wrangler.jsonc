{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "videoeval",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-31",
  "observability": { "enabled": true },

  // 静的ページは ./public。Worker は /api/* だけを処理し、それ以外は assets に流す。
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // AGEWEC 本体（agewec-site / agewec_2026）とは別の Worker・別の D1。
  // ダッシュボードで D1 を作り、その database_id をここに貼る。
  "d1_databases": [
    { "binding": "DB", "database_name": "videoeval", "database_id": "REPLACE_WITH_D1_ID" }
  ]

  // シークレットはダッシュボードで設定する:
  //   SESSION_SECRET   Cookie の署名鍵
  //   BOOTSTRAP_TOKEN  /setup/ の合言葉（初期化後は削除してよい）
}
